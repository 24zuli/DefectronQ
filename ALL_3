on = np.transpose(xhat_np, (1,2,0))\n\n    plt.figure(figsize=(12,4))\n\n    # Original\n    plt.subplot(1,4,1)\n    plt.imshow(orig)\n    plt.title(\"Original\")\n    plt.axis(\"off\")\n\n    # Reconstruction\n    plt.subplot(1,4,2)\n    plt.imshow(recon)\n    plt.title(\"Reconstruction\")\n    plt.axis(\"off\")\n\n    # Anomaly Map\n    plt.subplot(1,4,3)\n    plt.imshow(anomaly_map, cmap=\"hot\")\n    plt.colorbar(fraction=0.046, pad=0.04)\n    plt.title(\"Anomaly Map |x - x̂|\")\n    plt.axis(\"off\")\n\n    # Overlay\n    plt.subplot(1,4,4)\n    plt.imshow(orig)\n    plt.imshow(anomaly_map, cmap=\"jet\", alpha=0.5)\n    plt.title(\"Overlay\")\n    plt.axis(\"off\")\n\n    plt.suptitle(f\"{title} | Anomaly score = {scalar_score:.6f}\", fontsize=12)\n    plt.tight_layout()\n    plt.show()\n\n    print(f\"[{title}] Scalar anomaly score:\", scalar_score)\n    return scalar_score\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-22T10:23:49.020452Z","iopub.execute_input":"2026-01-22T10:23:49.021198Z","iopub.status.idle":"2026-01-22T10:23:49.030015Z","shell.execute_reply.started":"2026-01-22T10:23:49.021167Z","shell.execute_reply":"2026-01-22T10:23:49.029280Z"}},"outputs":[],"execution_count":20},{"cell_type":"code","source":"img_path = \"/kaggle/input/mvtec-ad/bottle/test/good/005.png\"\ninspect_image_by_path(model_c, img_path, device, title=\"Classical AE\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-22T10:24:06.754929Z","iopub.execute_input":"2026-01-22T10:24:06.755192Z","iopub.status.idle":"2026-01-22T10:24:07.152108Z","shell.execute_reply.started":"2026-01-22T10:24:06.755171Z","shell.execute_reply":"2026-01-22T10:24:07.151343Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 5 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"[Classical AE] Scalar anomaly score: 0.0016824163030833006\n","output_type":"stream"},{"execution_count":21,"output_type":"execute_r