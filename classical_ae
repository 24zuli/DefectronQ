    "def cleanup():\n",
    "    gc.collect()\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.empty_cache()\n",
    "\n",
    "def run_experiment(train_frac, seed, epochs=30):\n",
    "    set_seed(seed)\n",
    "\n",
    "    train_loader, test_loader = get_loaders(train_frac=train_frac, seed=seed, batch_size=64)\n",
    "    model = ConvAutoencoder(latent_dim=64).to(device)\n",
    "\n",
    "    train_ae(model, train_loader, device, epochs=epochs, lr=1e-3)\n",
    "\n",
    "    train_errs, _, _ = recon_errors(model, train_loader, device)\n",
    "    test_errs, test_y, _ = recon_errors(model, test_loader, device)\n",
    "\n",
    "    thr = choose_threshold(train_errs, percentile=95)\n",
    "    out = evaluate_scores(test_y, test_errs, thr)\n",
    "\n",
    "    # free memory\n",
    "    del model, train_loader, test_loader\n",
    "    cleanup()\n",
    "\n",
    "    return out\n",
    "\n",
    "fracs = [0.10, 0.25, 0.50, 1.0]\n",
    "seeds = [1, 2, 3]\n",
    "\n",
    "results = []\n",
    "for f in fracs:\n",
    "    for s in seeds:\n",
    "        print(f\"\\n=== Running frac={f}, seed={s} ===\")\n",
    "        m = run_experiment(f, s, epochs=30)\n",
    "        m[\"train_frac\"] = f\n",
    "        m[\"seed\"] = s\n",
    "        results.append(m)\n",
    "\n",
    "import pandas as pd\n",
    "df = pd.DataFrame(results)\n",
    "print(\"\\nRaw results:\")\n",
    "print(df)\n",
    "\n",
    "summary = df.groupby(\"train_frac\")[[\"AUROC\",\"AUPRC\",\"F1\"]].agg([\"mean\",\"std\"])\n",
    "print(\"\\nSummary (mean ± std):\")\n",
    "print(summary)\n"
   ]
