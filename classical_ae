    "from torch.amp import GradScaler, autocast\n",
    "\n",
    "def train_ae(model, train_loader, device, epochs=30, lr=1e-3):\n",
    "    model.to(device)\n",
    "    opt = torch.optim.Adam(model.parameters(), lr=lr)\n",
    "    scaler = GradScaler(\"cuda\", enabled=(device.type==\"cuda\"))\n",
    "\n",
    "    for ep in range(1, epochs + 1):\n",
    "        model.train()\n",
    "        losses = []\n",
    "        pbar = tqdm(train_loader, desc=f\"Epoch {ep}/{epochs}\", leave=False)\n",
    "\n",
    "        for x, _, _ in pbar:\n",
    "            x = x.to(device, non_blocking=False)\n",
    "            opt.zero_grad(set_to_none=True)\n",
    "\n",
    "            with autocast(\"cuda\", enabled=(device.type==\"cuda\")):\n",
    "                x_hat = model(x)\n",
    "                loss = F.mse_loss(x_hat, x)\n",
    "\n",
    "            scaler.scale(loss).backward()\n",
    "            scaler.step(opt)\n",
    "            scaler.update()\n",
    "\n",
    "            losses.append(loss.item())\n",
    "            pbar.set_postfix({\"loss\": float(np.mean(losses))})\n",
    "\n",
    "        print(f\"Epoch {ep:02d}  train_loss={np.mean(losses):.6f}\")\n",
    "\n",
    "@torch.no_grad()\n",
    "def recon_errors(model, loader, device):\n",
    "    model.eval()\n",
    "    errs, labels, paths = [], [], []\n",
    "    for x, y, p in loader:\n",
    "        x = x.to(device, non_blocking=False)\n",
    "        x_hat = model(x)\n",
    "        e = torch.mean((x - x_hat)**2, dim=(1,2,3)).detach().cpu().numpy()\n",
    "        errs.append(e)\n",
    "        labels.append(y.numpy())\n",
    "        paths += list(p)\n",
    "    return np.concatenate(errs), np.concatenate(labels), paths\n",
    "\n",
    "def choose_threshold(train_errs, percentile=95):\n",
    "    return float(np.percentile(train_errs, percentile))\n",
    "\n",
    "def evaluate_scores(y_true, scores, thr):\n",
    "    y_pred = (scores > thr).astype(int)\n",
    "    auroc = roc_auc_score(y_true, scores)\n",
    "    auprc = average_precision_score(y_true, scores)\n",
    "    f1 = f1_score(y_true, y_pred)\n",
    "\n",
    "    tp = int(((y_true==1) & (y_pred==1)).sum())\n",
    "    tn = int(((y_true==0) & (y_pred==0)).sum())\n",
    "    fp = int(((y_true==0) & (y_pred==1)).sum())\n",
    "    fn = int(((y_true==1) & (y_pred==0)).sum())\n",
    "\n",
    "    return {\"AUROC\": float(auroc), \"AUPRC\": float(auprc), \"F1\": float(f1),\n",
    "            \"thr\": float(thr), \"TP\": tp, \"TN\": tn, \"FP\": fp, \"FN\": fn}\n"
   ]
