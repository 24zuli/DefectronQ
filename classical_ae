    "def make_limited_subset(dataset, frac, seed=42):\n",
    "    assert 0 < frac <= 1.0\n",
    "    n = len(dataset)\n",
    "    k = max(1, int(n * frac))\n",
    "    rng = np.random.default_rng(seed)\n",
    "    idxs = rng.choice(n, size=k, replace=False).tolist()\n",
    "    return Subset(dataset, idxs)\n",
    "\n",
    "# Kaggle path you confirmed:\n",
    "DATA_ROOT = \"/kaggle/input/mvtec-ad/bottle\"\n",
    "\n",
    "train_ds_full = MVTecBottleDataset(DATA_ROOT, split=\"train\", image_size=64)\n",
    "test_ds = MVTecBottleDataset(DATA_ROOT, split=\"test\", image_size=64)\n",
    "\n",
    "print(\"Train normal images:\", len(train_ds_full))\n",
    "print(\"Test images (normal+anomaly):\", len(test_ds))\n",
    "\n",
    "def get_loaders(train_frac=1.0, seed=42, batch_size=64):\n",
    "    train_ds = make_limited_subset(train_ds_full, train_frac, seed=seed) if train_frac < 1.0 else train_ds_full\n",
    "\n",
    "    # Kaggle-stable settings:\n",
    "    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True,\n",
    "                              num_workers=0, pin_memory=False)\n",
    "    test_loader = DataLoader(test_ds, batch_size=batch_size, shuffle=False,\n",
    "                             num_workers=0, pin_memory=False)\n",
    "    return train_loader, test_loader\n",
    "\n",
    "# sanity check\n",
    "train_loader_10, test_loader = get_loaders(train_frac=0.10, seed=1, batch_size=20)\n",
    "x, y, _ = next(iter(train_loader_10))\n",
    "x2, y2, _ = next(iter(test_loader))\n",
    "print(\"Train batch:\", x.shape, \"labels:\", torch.unique(y))\n",
    "print(\"Test labels:\", torch.unique(y2))\n"
