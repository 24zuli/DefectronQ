    "class MVTecBottleDataset(Dataset):\n",
    "    \"\"\"\n",
    "    Unsupervised anomaly detection setup:\n",
    "    - train: only normal (train/good), label=0\n",
    "    - test: normal (test/good) label=0, all defects label=1\n",
    "    \"\"\"\n",
    "    IMG_EXTS = {\".png\",\".jpg\",\".jpeg\",\".bmp\",\".tif\",\".tiff\"}\n",
    "\n",
    "    def __init__(self, root, split=\"train\", image_size=64):\n",
    "        self.root = Path(root)\n",
    "        self.split = split\n",
    "        self.image_size = image_size\n",
    "\n",
    "        self.transform = transforms.Compose([\n",
    "            transforms.Grayscale(num_output_channels=1),\n",
    "            transforms.Resize((image_size, image_size)),\n",
    "            transforms.ToTensor(),\n",
    "            transforms.Normalize([0.5], [0.5]),  # -> roughly [-1, 1]\n",
    "        ])\n",
    "\n",
    "        self.samples = []\n",
    "\n",
    "        if split == \"train\":\n",
    "            train_good = self.root / \"train\" / \"good\"\n",
    "            for p in sorted(train_good.glob(\"*\")):\n",
    "                if p.suffix.lower() in self.IMG_EXTS:\n",
    "                    self.samples.append((str(p), 0))\n",
    "\n",
    "        elif split == \"test\":\n",
    "            test_dir = self.root / \"test\"\n",
    "            for defect_type in sorted([d for d in test_dir.iterdir() if d.is_dir()]):\n",
    "                label = 0 if defect_type.name == \"good\" else 1\n",
    "                for p in sorted(defect_type.glob(\"*\")):\n",
    "                    if p.suffix.lower() in self.IMG_EXTS:\n",
    "                        self.samples.append((str(p), label))\n",
    "        else:\n",
    "            raise ValueError(\"split must be 'train' or 'test'\")\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.samples)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        path, label = self.samples[idx]\n",
    "        img = Image.open(path).convert(\"RGB\")\n",
    "        x = self.transform(img)\n",
    "        return x, torch.tensor(label, dtype=torch.long), path\n"
   ]
